# ---------------------------------------------------------------
# Archivos que NO deben viajar al repositorio (es publico en GitHub)
# ---------------------------------------------------------------

# Credenciales del FTP: contiene host, usuario y CONTRASEÑA.
# Solo debe existir en tu PC. Nunca subirlo.
_tools/ftp-config.json

# Token de la API de Tienda Nube (regla de auto-ocultar sin stock).
# Es una credencial: solo en tu PC, nunca al repo publico.
_tools/tiendanube/api-config.json

# Registro de la ultima corrida de la regla auto-ocultar (local, de tu PC).
_tools/tiendanube/auto-ocultar-stock.log

# Tarjetas del sitio -> tienda segun stock: lo genera y sube cada hora
# _tools/tiendanube/stock-sitio.js (cambia seguido; no tiene sentido versionarlo).
stock-tienda.json
_tools/tiendanube/stock-historial.log

# Dependencias de Node: se reinstalan solas con "npm install".
node_modules/

# Registro local de "que archivos ya subi por FTP". Es de tu PC.
_tools/.subido.json

# Basura del sistema operativo
Thumbs.db
desktop.ini
.DS_Store
